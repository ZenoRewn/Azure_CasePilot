<Window x:Class="CasePilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CasePilot.App.Controls"
        xmlns:v="clr-namespace:CasePilot.App.Views"
        xmlns:vm="clr-namespace:CasePilot.App.ViewModels"
        Title="CasePilot" Width="1280" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        Foreground="{DynamicResource CpTextPrimary}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding GoCreateCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoCreateCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoHistoryCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding GoSettingsCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <!-- 自带 Adorner 层: 占位提示等装饰与内容同属一棵树 (截图 / 渲染一致) -->
    <AdornerDecorator>
    <Grid>
        <!-- 登录: Mica 背景上的居中卡片 -->
        <v:LoginView x:Name="LoginLayer" DataContext="{Binding Login}"
                     Visibility="{Binding DataContext.ShowLogin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}" />

        <Grid x:Name="ShellLayer"
              Visibility="{Binding ShowLogin, Converter={StaticResource Vis}, ConverterParameter=!}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition x:Name="DetailCol" Width="0" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 (Mica, 无填充) -->
            <Grid x:Name="Nav" Grid.Column="0" Margin="8,12,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,4,0,20">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CpAccent}">
                        <TextBlock Text="&#xE8F2;" Style="{StaticResource Icon}" Foreground="White" HorizontalAlignment="Center" FontSize="15" />
                    </Border>
                    <TextBlock Text="CasePilot" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <!-- 主操作: 整宽强调色按钮, 与 Web 端一致 -->
                    <Button Style="{StaticResource AccentButton}" Command="{Binding GoCreateCommand}" HorizontalAlignment="Stretch"
                            Margin="4,0,4,16" Height="36" ToolTip="新建 Case (Ctrl+N)" AutomationProperties.Name="新建 Case (主按钮)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="新建 Case" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="工作台" Style="{StaticResource Caption}" Margin="12,0,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding Shell.CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Create}"
                                 AutomationProperties.Name="新建 Case" ToolTip="新建 Case (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{DynamicResource CpAccent}" Margin="0,0,12,0" />
                            <TextBlock Text="新建 Case" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding Shell.CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=History}"
                                 AutomationProperties.Name="我的 Case" ToolTip="我的 Case (Ctrl+2)">
                        <Grid Width="204">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{DynamicResource CpAccent}" Margin="0,0,12,0" />
                                <TextBlock Text="我的 Case" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Margin="0,0,12,0" MinWidth="20" Height="18" CornerRadius="9" Padding="6,0"
                                    Background="{DynamicResource CpAccent}"
                                    Visibility="{Binding OpenBadge, Converter={StaticResource Vis}}"
                                    AutomationProperties.Name="{Binding OpenBadge, StringFormat=处理中 {0} 个}">
                                <TextBlock Text="{Binding OpenBadge}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>

                    <TextBlock Text="设置" Style="{StaticResource Caption}" Margin="12,20,0,6" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding Shell.CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=AISettings}"
                                 AutomationProperties.Name="AI 与语音" ToolTip="AI 与语音 (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource CpAccent}" Margin="0,0,12,0" />
                            <TextBlock Text="AI 与语音" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding Shell.CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Contacts}"
                                 AutomationProperties.Name="联系人">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{DynamicResource CpAccent}" Margin="0,0,12,0" />
                            <TextBlock Text="联系人" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="14" Margin="8,0,0,0" Foreground="{DynamicResource CpCaution}"
                                       ToolTip="联系人信息不完整" AutomationProperties.Name="联系人信息不完整"
                                       Visibility="{Binding Shell.ContactValid, Converter={StaticResource Vis}, ConverterParameter=!}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 IsChecked="{Binding Shell.CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter=Mcp}"
                                 AutomationProperties.Name="MCP">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Foreground="{DynamicResource CpAccent}" Margin="0,0,12,0" />
                            <TextBlock Text="MCP" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 身份卡 -->
                <Button x:Name="IdentityCard" Grid.Row="2" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch"
                        Padding="8" Click="IdentityCard_Click" AutomationProperties.Name="账户菜单"
                        ToolTip="{Binding Shell.PlanTooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource CpAccentSubtle}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Shell.Initials}" FontWeight="SemiBold" Foreground="{DynamicResource CpAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Shell.UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Shell.MethodLine}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Shell.PlanLine}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- 内容区: 不透明 -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource CpContentBg}" CornerRadius="8,0,0,0"
                    BorderBrush="{DynamicResource CpCardStroke}" BorderThickness="1,1,0,0" />
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 命令栏: 租户 / 订阅 / 刷新 -->
                <DockPanel Margin="24,12,16,8" LastChildFill="False">
                    <TextBlock Text="租户" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="TenantBox" Width="180" ItemsSource="{Binding Shell.Tenants}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTenant}" AutomationProperties.Name="租户" ToolTip="切换租户" />
                    <TextBlock Text="订阅" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox Width="190" ItemsSource="{Binding SubscriptionOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedSubscription}" AutomationProperties.Name="订阅" ToolTip="切换订阅" />
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            AutomationProperties.Name="刷新" ToolTip="刷新 (Ctrl+R / F5)">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding Shell.LoadingTickets, Converter={StaticResource Vis}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
                        <TextBlock Text="加载中…" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <!-- 错误 / Toast 由各页面在标题下方放置 c:PageBanner -->
                <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />
            </Grid>

            <!-- 详情面板 -->
            <GridSplitter x:Name="Splitter" Grid.Column="2" Width="5" HorizontalAlignment="Left" ResizeBehavior="PreviousAndCurrent"
                          Background="{DynamicResource CpDivider}" Visibility="Collapsed" AutomationProperties.Name="调整详情面板宽度" />
            <v:DetailView x:Name="DetailHost" Grid.Column="2" Margin="5,0,0,0" DataContext="{Binding Detail}" Visibility="Collapsed" />
        </Grid>
    </Grid>
    </AdornerDecorator>
</Window>
