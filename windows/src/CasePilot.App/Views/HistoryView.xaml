<UserControl x:Class="CasePilot.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CasePilot.App.Controls"
             xmlns:vm="clr-namespace:CasePilot.App.ViewModels">
    <Grid Margin="24,8,16,16" DataContext="{Binding History}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="我的 Case" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
        <c:PageBanner Grid.Row="1" />
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="True">
            <c:SegmentedControl SelectedIndex="{Binding Filter, Converter={StaticResource EnumIndex}}" AutomationProperties.Name="状态筛选">
                <ListBoxItem Content="{Binding AllLabel}" />
                <ListBoxItem Content="{Binding OpenLabel}" />
                <ListBoxItem Content="{Binding ClosedLabel}" />
            </c:SegmentedControl>
            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                    AutomationProperties.Name="刷新" ToolTip="刷新 (Ctrl+R)">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" />
            </Button>
            <ComboBox x:Name="Days" DockPanel.Dock="Right" Width="120" Margin="0,0,8,0" ItemsSource="{x:Static vm:HistoryVM.DayOptions}"
                      DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding Days, Mode=OneWay}"
                      SelectionChanged="DaysChanged" AutomationProperties.Name="时间范围" />
            <TextBox x:Name="Search" MinWidth="120" MaxWidth="260" HorizontalAlignment="Right" Margin="8,0,0,0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     c:Hint.Text="搜索 (Ctrl+F)" AutomationProperties.Name="搜索 Case" />
        </DockPanel>

        <Border Grid.Row="3" Background="{DynamicResource CpCardBg}" BorderBrush="{DynamicResource CpCardStroke}" BorderThickness="1" CornerRadius="8"
                Padding="1">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CpDivider}" SelectionMode="Single"
                          SelectionUnit="FullRow" CanUserResizeRows="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                          RowHeight="52" SizeChanged="GridSized" MouseDoubleClick="OpenRow" PreviewKeyDown="GridKey"
                          ColumnHeaderStyle="{StaticResource ListHeader}" CellStyle="{StaticResource ListCell}"
                          AutomationProperties.Name="Case 列表">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ListRow}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource Disp}, ConverterParameter=a11y}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制 Case 号" Click="CopyNumber" />
                            <MenuItem Header="在 Portal 打开" Click="OpenPortal" />
                            <Separator />
                            <MenuItem Header="关闭 Case…" Click="CloseCase" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Case #" Width="148" MinWidth="148" SortMemberPath="TicketNumber">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TicketNumber}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="8,0" ToolTip="{Binding TicketNumber}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="标题" Width="*" MinWidth="160" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Converter={StaticResource Disp}, ConverterParameter=sub}" Style="{StaticResource Caption}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Converter={StaticResource Disp}, ConverterParameter=sub}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="严重性" Width="72" SortMemberPath="Severity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Pill Label="严重性" Margin="8,0" Text="{Binding Severity, Converter={StaticResource Disp}, ConverterParameter=sev}"
                                            Kind="{Binding Severity, Converter={StaticResource Disp}, ConverterParameter=sevKind}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="88" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Pill Label="状态" Margin="8,0" Text="{Binding Status, Converter={StaticResource Disp}, ConverterParameter=status}"
                                            Kind="{Binding Status, Converter={StaticResource Disp}, ConverterParameter=statusKind}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="CreatedCol" Header="创建时间" Width="100" SortMemberPath="Created">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Created, Converter={StaticResource Disp}, ConverterParameter=rel}" Style="{StaticResource Caption}" Margin="8,0"
                                               VerticalAlignment="Center" ToolTip="{Binding Created, Converter={StaticResource Disp}, ConverterParameter=full}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- 加载失败但仍显示旧数据: 列表变淡 + 说明 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="12,6" CornerRadius="4"
                        Background="{DynamicResource CpCautionBg}" Visibility="{Binding IsStale, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource CpCaution}" VerticalAlignment="Center" />
                        <TextBlock Text="刷新失败, 显示的是上次加载的数据" Style="{StaticResource Caption}" Foreground="{DynamicResource CpTextPrimary}"
                                   Margin="8,0,0,0" ToolTip="{Binding LoadError}" />
                    </StackPanel>
                </Border>
                <!-- 加载失败且无数据: 错误状态 + 重试 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="{Binding LoadFailed, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource CpCritical}" HorizontalAlignment="Center" />
                    <TextBlock Text="无法加载 Case" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="重试" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,4" />
                </StackPanel>
                <!-- 空状态 / 加载状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource CpTextTertiary}" HorizontalAlignment="Center" />
                    <TextBlock Text="没有符合条件的 Case" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="调整时间范围或筛选条件, 或新建一个 Case。" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Loading, Converter={StaticResource Vis}}">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" />
                    <TextBlock Text="正在加载 Case…" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
