<UserControl x:Class="CasePilot.App.Views.McpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CasePilot.App.Controls"
             xmlns:vm="clr-namespace:CasePilot.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel MaxWidth="760" Margin="24,8,24,24">
            <TextBlock Text="MCP" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
            <TextBlock Text="把下面的配置加入 MCP 客户端 (如 Claude Desktop、VS Code), 让 AI 助手通过 CasePilot 查询与管理 Support Case。"
                       Style="{StaticResource Caption}" Margin="0,0,0,16" />
            <c:PageBanner />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="mcpServers (stdio)" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Command="{Binding CopyCommand}" Click="Copied">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="复制" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="13" Padding="12,10"
                             Background="{DynamicResource CpInfoBg}" AutomationProperties.Name="MCP 配置" />
                    <c:InfoBar Margin="0,12,0,0" Message="{x:Static vm:McpSettingsVM.Note}" Severity="Informational" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
