<UserControl x:Class="CasePilot.App.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CasePilot.App.Controls"
             Background="{DynamicResource CpCardBg}">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 头部 -->
        <StackPanel Margin="20,16,16,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="Close" AutomationProperties.Name="关闭详情面板" ToolTip="关闭 (Esc)">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                </Button>
                <!-- 与面板关闭按钮拉开并以分隔线隔开, 且使用不同图标, 避免误点 -->
                <Rectangle DockPanel.Dock="Right" Width="1" Height="24" Margin="14,0" Fill="{DynamicResource CpToolbarSeparator}" VerticalAlignment="Center"
                           AutomationProperties.Name="分隔" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding CloseCommand}" Margin="4,0,0,0" Padding="10,4"
                        AutomationProperties.Name="关闭此 Case" ToolTip="关闭此 Case (需确认)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource CpCritical}" />
                        <TextBlock Text="关闭 Case" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding OpenPortalCommand}"
                        AutomationProperties.Name="在 Portal 打开" ToolTip="在 Azure Portal 中打开">
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" />
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary.TicketNumber}" FontFamily="{DynamicResource MonoFont}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding CopyNumberCommand}" Margin="2,0,0,0"
                            AutomationProperties.Name="复制 Case 号" ToolTip="复制 Case 号">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Summary.Title}" Style="{StaticResource Body}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8" />
            <StackPanel Orientation="Horizontal">
                <c:Pill Text="{Binding Summary.Severity, Converter={StaticResource Disp}, ConverterParameter=sev}"
                        Kind="{Binding Summary.Severity, Converter={StaticResource Disp}, ConverterParameter=sevKind}" Margin="0,0,6,0" />
                <c:Pill Text="{Binding Summary.Status, Converter={StaticResource Disp}, ConverterParameter=status}"
                        Kind="{Binding Summary.Status, Converter={StaticResource Disp}, ConverterParameter=statusKind}" />
            </StackPanel>
            <c:InfoBar Message="{Binding Error}" Severity="Error" Margin="0,12,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="12,0,12,0" Style="{StaticResource PivotTabs}">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,8,8,16">
                        <ItemsControl ItemsSource="{Binding Overview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" FontSize="13" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                 Padding="0" TextWrapping="Wrap" FontSize="13" x:Name="V" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Mono}" Value="True">
                                            <Setter TargetName="V" Property="FontFamily" Value="{DynamicResource MonoFont}" />
                                            <Setter TargetName="V" Property="FontSize" Value="12" />
                                            <Setter TargetName="V" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="V" Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
                                            <Setter TargetName="V" Property="ToolTip" Value="{Binding Value}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="描述" Style="{StaticResource Label}" Margin="0,8,0,6"
                                   Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                        <TextBox Text="{Binding Description, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                 Padding="0" FontSize="13" Visibility="{Binding Description, Converter={StaticResource Vis}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Detail, Converter={StaticResource Vis}, ConverterParameter=!}" Margin="0,8,0,0">
                            <ProgressBar IsIndeterminate="True" Width="100" Height="4" />
                            <TextBlock Text="加载详情…" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding CommunicationsHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Communications}" Margin="8,8,8,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Msg" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="12,8,8,8" Margin="0,0,0,8"
                                        Background="{DynamicResource CpInfoBg}" CornerRadius="0,6,6,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Created, Converter={StaticResource Disp}, ConverterParameter=rel}"
                                                       Style="{StaticResource Caption}" ToolTip="{Binding Created, Converter={StaticResource Disp}, ConverterParameter=full}" />
                                            <TextBlock x:Name="Who" Text="{Binding Sender}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subject}" Style="{StaticResource Caption}" Margin="0,2,0,6" />
                                        <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource SelectableText}"
                                                 Padding="0" FontSize="13" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding FromMicrosoft}" Value="True">
                                        <Setter TargetName="Msg" Property="BorderBrush" Value="{DynamicResource CpAccent}" />
                                        <Setter TargetName="Msg" Property="Background" Value="{DynamicResource CpAccentSubtle}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 补充信息 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource CpDivider}" BorderThickness="0,1,0,0" Padding="16,12"
                IsEnabled="{Binding IsOpen}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReplyBox" Text="{Binding Reply, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         c:Hint.Text="补充信息 (Ctrl+Enter 发送)" AutomationProperties.Name="补充信息" />
                <c:MicButton Grid.Column="1" Target="{Binding ElementName=ReplyBox}" Margin="6,0,0,0" Height="32" VerticalAlignment="Bottom" />
                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" Margin="6,0,0,0"
                        Height="32" VerticalAlignment="Bottom" ToolTip="Ctrl+Enter"
                        AutomationProperties.Name="发送补充信息" AutomationProperties.AcceleratorKey="Ctrl+Enter">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="14" Foreground="White" Margin="0,0,6,0" />
                        <TextBlock Text="发送" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
