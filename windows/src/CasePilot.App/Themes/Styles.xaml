<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CasePilot.App.Controls">

    <!-- 字体: Segoe UI Variable → Microsoft YaHei UI; 代码 / Case 号: Cascadia Mono → Consolas -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 颜色令牌 (Fluent 2 Light). 全部经 DynamicResource 引用, 便于以后加深色 -->
    <SolidColorBrush x:Key="CpTextPrimary" Color="#E4000000" />
    <SolidColorBrush x:Key="CpTextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="CpTextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="CpContentBg" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="CpCardBg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CpCardStroke" Color="#14000000" />
    <SolidColorBrush x:Key="CpDivider" Color="#0F000000" />
    <!-- 工具栏内的竖向分隔: 需在浅色背景上清晰可见 -->
    <SolidColorBrush x:Key="CpToolbarSeparator" Color="#38000000" />
    <SolidColorBrush x:Key="CpSubtleFill" Color="#09000000" />
    <SolidColorBrush x:Key="CpSubtleFillHover" Color="#0F000000" />
    <SolidColorBrush x:Key="CpNavFallback" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="CpAccent" Color="#FF005FB8" />
    <SolidColorBrush x:Key="CpAccentHover" Color="#FF196EBF" />
    <SolidColorBrush x:Key="CpAccentDisabled" Color="#37000000" />
    <SolidColorBrush x:Key="CpAccentSubtle" Color="#FFE5F0FA" />
    <SolidColorBrush x:Key="CpOnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CpSuccess" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="CpSuccessBg" Color="#FFDFF6DD" />
    <SolidColorBrush x:Key="CpCaution" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="CpCautionBg" Color="#FFFFF4CE" />
    <SolidColorBrush x:Key="CpCritical" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="CpCriticalBg" Color="#FFFDE7E9" />
    <SolidColorBrush x:Key="CpNeutral" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="CpNeutralBg" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="CpInfoBg" Color="#FFF6F6F6" />

    <!-- 字号 -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片: 不透明, 圆角 8 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CpCardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CpCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 按钮 -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CpOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource CpAccent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpAccentDisabled}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource CpTextPrimary}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 透明按钮: 图标按钮、链接、导航项 -->
    <Style x:Key="SubtleButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            BorderThickness="0" BorderBrush="{DynamicResource CpTextPrimary}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpSubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpSubtleFillHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Foreground" Value="{DynamicResource CpAccent}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- 左侧导航项 (RadioButton 分组) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="12,0">
                        <Grid>
                            <Border x:Name="Ind" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource CpAccent}"
                                    HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpSubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource CpSubtleFillHover}" />
                            <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource CpTextPrimary}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段控件 -->
    <Style TargetType="c:SegmentedControl">
        <Setter Property="Background" Value="{DynamicResource CpSubtleFill}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SegmentedControl">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="14,5" MinHeight="30"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource CpSubtleFill}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource CpCardBg}" />
                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource CpCardStroke}" />
                                        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource CpTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 快捷选择 chip -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Background" Value="{DynamicResource CpSubtleFill}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldGap" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- 详情页 Pivot 标签: 透明背景, 选中项下方 3px 圆角强调条 (Fluent Pivot / SelectorBar) -->
    <Style x:Key="PivotTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource CpDivider}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid Background="Transparent" Margin="0,0,4,0">
                                    <Border x:Name="Focus" BorderBrush="{DynamicResource CpTextPrimary}" BorderThickness="0" CornerRadius="4" Margin="0,2,0,5" />
                                    <ContentPresenter ContentSource="Header" Margin="12,8,12,10" HorizontalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Border x:Name="Indicator" Height="3" Width="16" CornerRadius="1.5" VerticalAlignment="Bottom"
                                            Background="{DynamicResource CpAccent}" Visibility="Hidden" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Focus" Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Case 列表: 表头与单元格同为 8px 内边距, 无 Aero 分隔线; 选中行用强调浅色 + 左侧 3px 强调条 -->
    <Style x:Key="ListHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" BorderBrush="{DynamicResource CpDivider}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <TextBlock x:Name="Sort" DockPanel.Dock="Right" Style="{StaticResource Icon}" FontSize="10" Margin="4,0,0,0"
                                       Foreground="{DynamicResource CpTextTertiary}" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Sort" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Sort" Property="Text" Value="&#xE70D;" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource CpTextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <ContentPresenter VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource CpAccent}" Visibility="Hidden" />
                        <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CpSubtleFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CpAccentSubtle}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
